# Base URL of the FastAPI app (rag_core.api:app). No trailing path.
VITE_API_URL=http://localhost:8000

# Leave false to call the FastAPI app. true returns fixtures from src/mocks/
# for every endpoint except POST /ask, which always uses VITE_API_URL.
VITE_USE_MOCKS=false

# Optional per-endpoint override. When this list is non-empty it replaces
# VITE_USE_MOCKS: only the named calls are mocked. POST /ask is never mocked.
# Names: upload, analyse, generate, submit, run
# VITE_MOCK_ENDPOINTS=upload,analyse,generate,submit,run
