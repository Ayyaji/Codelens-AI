# Base URL of the FastAPI app (rag_core.api:app). No trailing slash.
# Laptop: http://localhost:8000
# Simple deploy (Vercel): https://13-234-56-78.sslip.io   (the URL backend-setup.sh prints)
# Three-server deploy: /api   (Nginx on the frontend proxies this to the backend)
# S3 alternative: https://your-api-host
# deploy/frontend/deploy.sh and upload-s3.sh read the environment variable,
# and that value wins over this file.
VITE_API_URL=http://localhost:8000

# Leave false to call the FastAPI app. true returns fixtures from src/mocks/
# for every endpoint the screens call, including POST /ask, auth, My Space,
# and the teacher routes. One flag. Demo accounts are in the frontend README.
VITE_USE_MOCKS=false

# Optional per-endpoint override. When this list is non-empty it replaces
# VITE_USE_MOCKS: only the named calls are mocked.
# Names: upload, analyse, generate, submit, run, auth, ask, chats, persona,
# history, overview, students, activity, kb
# VITE_MOCK_ENDPOINTS=upload,analyse,generate,submit,run
