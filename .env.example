GROQ_API_KEY=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=codelens
JWT_SECRET=change-me-to-a-long-random-string
# Three-server deploy (private IP of the MongoDB instance, authSource=admin):
# MONGODB_URI=mongodb://codelens:PASSWORD@10.0.2.10:27017/codelens?authSource=admin
# Atlas alternative: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Leave CORS_ORIGINS empty when Nginx proxies /api on the same host.
# Set it to the CloudFront URL only for the S3 alternative, with no trailing slash.
CORS_ORIGINS=
